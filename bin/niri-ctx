#!/usr/bin/env bash
set -euo pipefail

APP_PREFIX="dev.yiannis.niri"
COMMS_WORKSPACE="comms"
TOP_WORKSPACE="top-ambient"
SCRATCH_WORKSPACE="scratch"
LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/niri-ctx"
LOG_FILE="$LOG_DIR/log"
CACHE_DIR="$LOG_DIR"
LOCK_FILE="${XDG_RUNTIME_DIR:-$LOG_DIR}/niri-ctx.lock"
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s\n' "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd)"
CONFIG_FILE="$REPO_ROOT/.config/niri/contexts.conf"

if [[ -r "$CONFIG_FILE" ]]; then
    # shellcheck source=.config/niri/contexts.conf
    source "$CONFIG_FILE"
elif [[ -r "$HOME/.config/niri/contexts.conf" ]]; then
    # shellcheck source=/dev/null
    source "$HOME/.config/niri/contexts.conf"
else
    printf 'niri-ctx: missing contexts.conf\n' >&2
    exit 1
fi
SESSION_BACKEND="${SESSION_BACKEND:-${AGENTS_BACKEND:-herdr}}"

usage() {
    cat >&2 <<'USAGE'
usage:
  niri-ctx open <UP|Webroot|Sealant|Side|Admin|current> [all|docs|output|editor|agents|logs|term|repo:<label>]
  niri-ctx scratch
  niri-ctx comms
  niri-ctx devtools-here
  niri-ctx top-ambient
  niri-ctx spotify
  niri-ctx watch
  niri-ctx startup
  niri-ctx doctor
  niri-ctx --tmux-role <ctx> <role>
USAGE
}

log_line() {
    local tmp
    mkdir -p "$LOG_DIR"
    printf '%s pid=%s %s\n' "$(date '+%F %T')" "$$" "$*" >> "$LOG_FILE"
    if [[ -f "$LOG_FILE" ]] && [[ "$(wc -l < "$LOG_FILE")" -gt 2400 ]]; then
        tmp="$(mktemp "$LOG_DIR/log.XXXXXX")"
        tail -n 2000 "$LOG_FILE" > "$tmp" && mv -f "$tmp" "$LOG_FILE"
    fi
}

die() {
    log_line "FAIL $*"
    printf 'niri-ctx: %s\n' "$*" >&2
    exit 1
}

niri_action() {
    log_line "action niri msg action $*"
    niri msg action "$@" >/dev/null
}

is_uint() {
    [[ "${1:-}" =~ ^[0-9]+$ ]]
}

spawn_detached() {
    (
        exec 9>&- 2>/dev/null || true
        setsid -f "$@" >/dev/null 2>&1
    )
}

normalize_context() {
    local raw="${1:-}" lower
    lower="$(printf '%s\n' "$raw" | tr '[:upper:]' '[:lower:]')"
    case "$lower" in
        up|job1) printf 'UP\n' ;;
        webroot|job2) printf 'Webroot\n' ;;
        sealant|side1) printf 'Sealant\n' ;;
        side|side2) printf 'Side\n' ;;
        admin) printf 'Admin\n' ;;
        *) return 1 ;;
    esac
}

context_slug() {
    case "$1" in
        UP) printf 'up\n' ;;
        Webroot) printf 'webroot\n' ;;
        Sealant) printf 'sealant\n' ;;
        Side) printf 'side\n' ;;
        Admin) printf 'admin\n' ;;
        # Pseudo-context: only for card app-ids/cache names, never a valid
        # `open` target (normalize_context deliberately excludes it).
        scratch) printf 'scratch\n' ;;
        *) return 1 ;;
    esac
}

context_from_workspace() {
    local ws="${1:-}"
    ws="${ws%-devtools}"
    normalize_context "$ws"
}

normalize_role() {
    local raw="${1:-all}" lower
    lower="$(printf '%s\n' "$raw" | tr '[:upper:]' '[:lower:]')"
    case "$lower" in
        all) printf 'all\n' ;;
        browser|browser-docs|docs) printf 'docs\n' ;;
        browser-output|output) printf 'output\n' ;;
        editor) printf 'editor\n' ;;
        agents) printf 'agents\n' ;;
        logs) printf 'logs\n' ;;
        shell|terminal|term) printf 'term\n' ;;
        repo:*)
            [[ "${lower#repo:}" =~ ^[a-z0-9_-]+$ ]] || return 1
            printf '%s\n' "$lower"
            ;;
        *) return 1 ;;
    esac
}

terminal_role_name() {
    case "$1" in
        editor|agents|logs|term|repo:*) printf '%s\n' "$1" ;;
        *) return 1 ;;
    esac
}

# Repos of a context, one "label=dir" per line in declared order.
ctx_repo_specs() {
    local specs=()
    read -ra specs <<< "${CTX_REPOS[$1]:-}"
    printf '%s\n' ${specs[@]+"${specs[@]}"}
}

ctx_default_repo_label() {
    local spec
    spec="$(ctx_repo_specs "$1" | head -n1)"
    if [[ -n "$spec" ]]; then
        printf '%s\n' "${spec%%=*}"
    else
        printf 'main\n'
    fi
}

ctx_default_repo_dir() {
    local spec
    spec="$(ctx_repo_specs "$1" | head -n1)"
    if [[ "$spec" == *=* ]]; then
        printf '%s\n' "${spec#*=}"
    else
        printf '%s\n' "$HOME"
    fi
}

ctx_repo_dir() {
    local spec
    while IFS= read -r spec; do
        if [[ "${spec%%=*}" == "$2" && "$spec" == *=* ]]; then
            printf '%s\n' "${spec#*=}"
            return 0
        fi
    done < <(ctx_repo_specs "$1")
    return 1
}

# One work card per context; roles live INSIDE it as herdr workspaces
# (tmux windows in the fallback), so the app id no longer carries a role.
terminal_app_id() {
    printf '%s.%s.work\n' "$APP_PREFIX" "$(context_slug "$1")"
}

terminal_title() {
    printf '%s-work\n' "$1"
}

ctx_workspace_id_from_json() {
    local workspaces_json="$1" workspace="$2"
    jq -r --arg workspace "$workspace" \
        'first(.[] | select((.name // "" | ascii_downcase) == ($workspace | ascii_downcase)) | .id) // empty' \
        <<< "$workspaces_json"
}

ctx_focused_workspace_name_from_json() {
    jq -r 'first(.[] | select(.is_focused) | .name // empty) // empty'
}

ctx_active_workspace_on_output_from_json() {
    local output="$1"
    jq -r --arg output "$output" \
        'first(.[] | select(.output == $output and .is_active) | .name // empty) // empty'
}

current_context() {
    local workspaces_json focused_ws main_ws ctx
    workspaces_json="$(niri msg --json workspaces)"
    focused_ws="$(ctx_focused_workspace_name_from_json <<< "$workspaces_json")"
    if ctx="$(context_from_workspace "$focused_ws" 2>/dev/null)"; then
        printf '%s\n' "$ctx"
        return 0
    fi
    main_ws="$(ctx_active_workspace_on_output_from_json "$MAIN_OUTPUT" <<< "$workspaces_json")"
    if ctx="$(context_from_workspace "$main_ws" 2>/dev/null)"; then
        printf '%s\n' "$ctx"
        return 0
    fi
    printf 'could not infer project context from focused workspace "%s" or main workspace "%s"\n' \
        "${focused_ws:-unnamed}" "${main_ws:-unnamed}" >&2
    return 1
}

ctx_focus_monitor() {
    local output="$1" workspaces_json output_exists output_focused
    workspaces_json="$(niri msg --json workspaces)"
    output_exists="$(jq -r --arg output "$output" 'any(.[]; .output == $output)' <<< "$workspaces_json")"
    [[ "$output_exists" == "true" ]] || return 0
    output_focused="$(jq -r --arg output "$output" 'any(.[]; .output == $output and .is_focused)' <<< "$workspaces_json")"
    if [[ "$output_focused" != "true" ]]; then
        niri_action focus-monitor "$output"
    fi
}

ctx_focus_workspace() {
    local output="$1" workspace="$2" workspaces_json target_json target_focused target_active target_output output_focused
    workspaces_json="$(niri msg --json workspaces)"
    target_json="$(jq -c --arg workspace "$workspace" \
        'first(.[] | select((.name // "" | ascii_downcase) == ($workspace | ascii_downcase))) // empty' \
        <<< "$workspaces_json")"
    [[ -n "$target_json" ]] || return 0
    target_focused="$(jq -r '.is_focused' <<< "$target_json")"
    [[ "$target_focused" != "true" ]] || return 0
    target_active="$(jq -r '.is_active' <<< "$target_json")"
    target_output="$(jq -r '.output // empty' <<< "$target_json")"
    output_focused="$(jq -r --arg output "$output" 'any(.[]; .output == $output and .is_focused)' <<< "$workspaces_json")"
    if [[ "$output_focused" != "true" ]]; then
        niri_action focus-monitor "$output"
    fi
    if [[ "$target_active" != "true" || "$target_output" != "$output" ]]; then
        niri_action focus-workspace "$workspace"
    fi
}

window_id_by_app_id() {
    local app_id="$1"
    # Deterministic pick: JSON order is unstable (HashMap), so with duplicate
    # windows always choose the oldest (lowest id).
    niri msg --json windows \
        | jq -r --arg app_id "$app_id" '[.[] | select(.app_id == $app_id) | .id] | sort | (.[0] // empty)'
}

terminal_window_id() {
    local ctx="$1" role="$2" app_id
    app_id="$(terminal_app_id "$ctx" "$role")"
    window_id_by_app_id "$app_id"
}

browser_cache_file() {
    local ctx="$1" role="$2"
    printf '%s/browser-%s-%s.id\n' "$CACHE_DIR" "$(context_slug "$ctx")" "$role"
}

helium_command() {
    local found
    if [[ -x "$HELIUM_BIN" ]]; then
        printf '%s\n' "$HELIUM_BIN"
        return 0
    fi
    if found="$(command -v helium 2>/dev/null)"; then
        printf '%s\n' "$found"
        return 0
    fi
    return 1
}

ctx_wait_window() {
    local jq_filter="$1" timeout_seconds="$2" start now elapsed remaining line found es_fd es_pid status=1
    exec {es_fd}< <(niri msg --json event-stream)
    es_pid=$!
    start="$(date +%s)"
    while true; do
        now="$(date +%s)"
        elapsed=$((now - start))
        remaining=$((timeout_seconds - elapsed))
        ((remaining > 0)) || break
        if ! IFS= read -r -t "$remaining" -u "$es_fd" line; then
            break
        fi
        found="$(jq -r "$jq_filter" <<< "$line" 2>/dev/null || true)"
        if [[ -n "$found" && "$found" != "null" ]]; then
            printf '%s\n' "$found"
            status=0
            break
        fi
    done
    exec {es_fd}<&-
    [[ -n "${es_pid:-}" ]] && kill "$es_pid" 2>/dev/null || true
    return "$status"
}

wait_for_app_id() {
    local app_id="$1" timeout_seconds="${2:-10}" filter
    export NIRI_CTX_WAIT_APP_ID="$app_id"
    filter='first((.WindowsChanged.windows[]?, .WindowOpenedOrChanged.window?) | select(.app_id == env.NIRI_CTX_WAIT_APP_ID) | .id) // empty'
    ctx_wait_window "$filter" "$timeout_seconds"
}

wait_for_new_helium() {
    local before_ids="$1" timeout_seconds="${2:-10}" filter
    export NIRI_CTX_BEFORE_IDS="$before_ids"
    # Bind the window id to $wid before the index() check: a jq function
    # argument is evaluated against the function's OWN input (the before-ids
    # array), so a bare `.id` in there indexes the array and errors out.
    filter='first((.WindowsChanged.windows[]?, .WindowOpenedOrChanged.window?)
        | select(.app_id == "helium")
        | (.id | tostring) as $wid
        | select((env.NIRI_CTX_BEFORE_IDS | split(",") | map(select(length > 0)) | index($wid)) | not)
        | .id) // empty'
    ctx_wait_window "$filter" "$timeout_seconds"
}

# Cache format: line 1 = window id, line 2 = NIRI_SOCKET the id belongs to.
# Window ids restart when the compositor restarts, so an id from a previous
# compositor instance must never be trusted.
valid_browser_cache_id() {
    local ctx="$1" role="$2" cache_file id cached_sock found_id
    cache_file="$(browser_cache_file "$ctx" "$role")"
    [[ -f "$cache_file" ]] || return 1
    { IFS= read -r id || true; IFS= read -r cached_sock || true; } < "$cache_file"
    if ! is_uint "$id"; then
        rm -f "$cache_file"
        return 1
    fi
    if [[ -n "$cached_sock" && "$cached_sock" != "${NIRI_SOCKET:-}" ]]; then
        rm -f "$cache_file"
        return 1
    fi
    # The window may live on ANY workspace (the caller re-homes it); it just
    # has to exist and still be a helium window.
    found_id="$(niri msg --json windows | jq -r --argjson id "$id" \
        'first(.[] | select(.id == $id and .app_id == "helium") | .id) // empty')"
    if [[ "$found_id" == "$id" ]]; then
        printf '%s\n' "$id"
        return 0
    fi
    rm -f "$cache_file"
    return 1
}

atomic_cache_write() {
    local file="$1" value="$2" tmp
    mkdir -p "$(dirname -- "$file")"
    tmp="$(mktemp "$(dirname -- "$file")/.tmp.XXXXXX")"
    printf '%s\n%s\n' "$value" "${NIRI_SOCKET:-}" > "$tmp"
    mv -f "$tmp" "$file"
}

focus_window_id() {
    local id="$1"
    is_uint "$id" || return 1
    niri_action focus-window --id "$id" || true
}

launch_terminal_role() {
    local ctx="$1" role="$2" app_id title
    app_id="$(terminal_app_id "$ctx" "$role")"
    title="$(terminal_title "$ctx" "$role")"
    case "$CONTEXT_TERMINAL" in
        ghostty)
            if ! command -v ghostty >/dev/null 2>&1; then
                die "ghostty is not installed"
            fi
            spawn_detached ghostty --gtk-single-instance=false --class="$app_id" --title="$title" -e "$SCRIPT_PATH" --tmux-role "$ctx" "$role"
            ;;
        alacritty)
            if ! command -v alacritty >/dev/null 2>&1; then
                die "alacritty is not installed"
            fi
            spawn_detached alacritty --class "$app_id,$app_id" --title "$title" -e "$SCRIPT_PATH" --tmux-role "$ctx" "$role"
            ;;
        *)
            die "unsupported NIRI_CONTEXT_TERMINAL=$CONTEXT_TERMINAL; use ghostty or alacritty so app-id can be detected"
            ;;
    esac
}

focus_or_launch_terminal() {
    local ctx="$1" role="$2" id app_id ctx_ws_id cur_ws_id attempt session session_was_fresh=0
    role="$(terminal_role_name "$role")"
    session="$(role_session_name "$ctx" "$role" || true)"
    id="$(terminal_window_id "$ctx" "$role")"
    if [[ -n "$id" ]]; then
        # Re-home a card that was moved off its context workspace.
        ctx_ws_id="$(ctx_workspace_id_from_json "$(niri msg --json workspaces)" "$ctx")"
        cur_ws_id="$(window_workspace_id_for_id "$id" || true)"
        if is_uint "$ctx_ws_id" && [[ "$cur_ws_id" != "$ctx_ws_id" ]]; then
            niri_action move-window-to-workspace --window-id "$id" --focus false "$ctx" || true
        fi
        ctx_focus_workspace "$MAIN_OUTPUT" "$ctx"
        focus_window_id "$id"
        deep_link_role "$ctx" "$role"
        printf '%s\n' "$id"
        return 0
    fi
    ctx_focus_workspace "$MAIN_OUTPUT" "$ctx"
    app_id="$(terminal_app_id "$ctx" "$role")"
    if [[ "${SESSION_BACKEND:-herdr}" == "herdr" ]] && ! herdr_session_exists "$session"; then
        session_was_fresh=1
    fi
    for attempt in 1 2; do
        launch_terminal_role "$ctx" "$role"
        id="$(wait_for_app_id "$app_id" 10 || true)"
        if [[ -n "$id" ]]; then
            focus_window_id "$id"
            printf '%s\n' "$id"
            return 0
        fi
        if [[ "$attempt" == 1 ]]; then
            log_line "timeout waiting for terminal ctx=$ctx role=$role app_id=$app_id; killing windowless terminal and retrying"
            # ghostty spells it --class=<id>, alacritty --class <id>,<id>
            pkill -f -- "-class[= ]${app_id//./\\.}" 2>/dev/null || true
            continue
        fi
        break
    done
    # The final attempt also timed out: reap its windowless terminal too, or
    # hung instances accumulate and poison later spawns.
    pkill -f -- "-class[= ]${app_id//./\\.}" 2>/dev/null || true
    if ((session_was_fresh)) && herdr_session_exists "$session"; then
        reap_fresh_herdr_session "$session"
    fi
    log_line "timeout waiting for terminal ctx=$ctx role=$role app_id=$app_id"
    return 1
}

focus_or_launch_browser() {
    local ctx="$1" role="$2" id before_ids helium cache_file profile ctx_ws_id cur_ws_id
    case "$role" in
        docs|output) ;;
        *) return 1 ;;
    esac
    if id="$(valid_browser_cache_id "$ctx" "$role")"; then
        # Re-home a browser card that was moved off its context workspace.
        ctx_ws_id="$(ctx_workspace_id_from_json "$(niri msg --json workspaces)" "$ctx")"
        cur_ws_id="$(window_workspace_id_for_id "$id" || true)"
        if is_uint "$ctx_ws_id" && [[ "$cur_ws_id" != "$ctx_ws_id" ]]; then
            niri_action move-window-to-workspace --window-id "$id" --focus false "$ctx" || true
        fi
        ctx_focus_workspace "$MAIN_OUTPUT" "$ctx"
        focus_window_id "$id"
        printf '%s\n' "$id"
        return 0
    fi
    if ! helium="$(helium_command)"; then
        die "helium is not installed and HELIUM_BIN is not executable"
    fi
    profile="${CTX_HELIUM_PROFILE[$ctx]:-Default}"
    before_ids="$(niri msg --json windows | jq -r '[.[] | select(.app_id == "helium") | .id | tostring] | join(",")')"
    log_line "spawn helium ctx=$ctx role=$role profile=$profile"
    spawn_detached "$helium" --profile-directory="$profile" --new-window about:blank
    id="$(wait_for_new_helium "$before_ids" 10 || true)"
    if [[ -z "$id" || ! "$id" =~ ^[0-9]+$ ]]; then
        log_line "timeout waiting for helium ctx=$ctx role=$role"
        return 1
    fi
    cache_file="$(browser_cache_file "$ctx" "$role")"
    niri_action move-window-to-workspace --window-id "$id" --focus false "$ctx" || true
    ctx_focus_workspace "$MAIN_OUTPUT" "$ctx"
    focus_window_id "$id"
    atomic_cache_write "$cache_file" "$id"
    printf '%s\n' "$id"
}

column_index_for_id() {
    local id="$1"
    is_uint "$id" || return 1
    niri msg --json windows \
        | jq -r --argjson id "$id" \
            'first(.[] | select(.id == $id) | .layout.pos_in_scrolling_layout[0]) // empty'
}

window_workspace_id_for_id() {
    local id="$1"
    is_uint "$id" || return 1
    niri msg --json windows \
        | jq -r --argjson id "$id" 'first(.[] | select(.id == $id) | .workspace_id) // empty'
}

move_column_to_index_if_needed() {
    local id="$1" expected_index="$2" ctx="$3" workspaces_json workspace_id current_ws current_col
    is_uint "$id" || return 0
    workspaces_json="$(niri msg --json workspaces)"
    workspace_id="$(ctx_workspace_id_from_json "$workspaces_json" "$ctx")"
    is_uint "$workspace_id" || return 0
    current_ws="$(window_workspace_id_for_id "$id")"
    [[ "$current_ws" == "$workspace_id" ]] || return 0
    current_col="$(column_index_for_id "$id")"
    is_uint "$current_col" || return 0
    [[ "$current_col" == "$expected_index" ]] && return 0
    focus_window_id "$id"
    niri_action move-column-to-index "$expected_index" || true
}

# Break apart columns that contain 2+ of OUR tracked card windows, so the
# one-card-per-column order can always be rebuilt — without disturbing any
# stack the user built out of non-card windows.
flatten_tracked_cards() {
    local ctx="$1"; shift
    local ids=() id workspace_id ids_json target
    for id in "$@"; do
        is_uint "$id" && ids+=("$id")
    done
    ((${#ids[@]} > 1)) || return 0
    workspace_id="$(ctx_workspace_id_from_json "$(niri msg --json workspaces)" "$ctx")"
    is_uint "$workspace_id" || return 0
    ids_json="$(jq -nc '$ARGS.positional | map(tonumber)' --args "${ids[@]}")"
    for _ in 1 2 3 4 5 6 7 8; do
        target="$(niri msg --json windows | jq -r --argjson ws "$workspace_id" --argjson ids "$ids_json" '
            [.[] | select(.workspace_id == $ws and .is_floating == false and .layout.pos_in_scrolling_layout != null)
                 | select(.id as $i | $ids | index($i))]
            | group_by(.layout.pos_in_scrolling_layout[0])
            | map(select(length > 1))
            | if length == 0 then empty
              else (.[0] | sort_by(.layout.pos_in_scrolling_layout[1]) | .[-1].id)
              end')"
        is_uint "$target" || return 0
        niri_action focus-window --id "$target" || return 0
        niri_action expel-window-from-column || return 0
        sleep 0.1
    done
}

open_all() {
    local ctx="$1" docs_id work_id work_role=editor
    ctx_focus_workspace "$MAIN_OUTPUT" "$ctx"
    [[ "$ctx" == "Admin" ]] && work_role=term
    # A single slow/failed card must not abort the rest of the context open.
    # Two cards per context: docs browser + the work terminal (roles are
    # herdr workspaces inside it). The output browser stays on-demand.
    docs_id="$(focus_or_launch_browser "$ctx" docs || true)"
    work_id="$(focus_or_launch_terminal "$ctx" "$work_role" || true)"
    flatten_tracked_cards "$ctx" "$docs_id" "$work_id"
    move_column_to_index_if_needed "$docs_id" 1 "$ctx"
    move_column_to_index_if_needed "$work_id" 2 "$ctx"
    ctx_focus_workspace "$MAIN_OUTPUT" "$ctx"
    if [[ -n "$docs_id" ]]; then
        focus_window_id "$docs_id"
    fi
}

open_role() {
    local ctx="$1" role="$2"
    case "$role" in
        all) open_all "$ctx" ;;
        docs|output) focus_or_launch_browser "$ctx" "$role" >/dev/null ;;
        editor|agents|logs|term|repo:*) focus_or_launch_terminal "$ctx" "$role" >/dev/null ;;
        *) return 1 ;;
    esac
}

# Fallback backend: one tmux session per context. tmux has no workspace
# layer, so the herdr repo/tab canon flattens to windows named "repo/role".
tmux_attach_work() {
    local session="$1" ctx="$2" role="$3" window spec label dir first=1 cur repo
    if ! tmux has-session -t "$session" 2>/dev/null; then
        if [[ "$ctx" == "Admin" ]]; then
            tmux new-session -d -s "$session" -c "$HOME" -n term
        else
            while IFS= read -r spec; do
                label="${spec%%=*}"
                dir="${spec#*=}"
                [[ -n "$label" && "$spec" == *=* ]] || continue
                if ((first)); then
                    tmux new-session -d -s "$session" -c "$dir" -n "$label/editor" nvim
                    first=0
                else
                    tmux new-window -d -t "$session" -c "$dir" -n "$label/editor" nvim
                fi
                tmux new-window -d -t "$session" -c "$dir" -n "$label/agents"
                tmux new-window -d -t "$session" -c "$dir" -n "$label/logs"
            done < <(ctx_repo_specs "$ctx")
            if ((first)); then
                tmux new-session -d -s "$session" -c "$HOME" -n term
            fi
        fi
    fi
    if [[ "$ctx" == "Admin" ]]; then
        window=term
    elif [[ "$role" == repo:* ]]; then
        window="${role#repo:}/editor"
    else
        # Role acts on the current repo, read off the active window's name.
        cur="$(tmux display-message -p -t "$session" '#{window_name}' 2>/dev/null || true)"
        repo="${cur%%/*}"
        [[ -n "$repo" && "$cur" == */* ]] || repo="$(ctx_default_repo_label "$ctx")"
        window="$repo/$role"
    fi
    tmux select-window -t "${session}:${window}" 2>/dev/null \
        || tmux select-window -t "${session}:${role}" 2>/dev/null || true
    exec tmux attach-session -t "$session"
}

herdr_session_name_valid() {
    # -work is the current scheme; the rest are legacy per-role sessions that
    # may still exist and must stay addressable for cleanup.
    [[ "${1:-}" =~ ^[A-Za-z]+-(work|dev|agents|logs|terminal)$ ]]
}

role_session_name() {
    local ctx="$1" role="$2"
    case "$role" in
        editor|agents|logs|term|repo:*) printf '%s-work\n' "$ctx" ;;
        *) return 1 ;;
    esac
}

herdr_sock_for_session() {
    printf '%s/.config/herdr/sessions/%s/herdr.sock\n' "$HOME" "$1"
}

herdr_sock_cmd() {
    local sock="$1"
    shift
    timeout 2 env HERDR_SOCKET_PATH="$sock" herdr "$@" 2>/dev/null
}

# Start nvim in a pane. Only ever called for panes created by THIS run, so
# the target is guaranteed to be an idle fresh shell.
herdr_run_editor() {
    local sock="$1" pane="$2"
    [[ "$pane" =~ ^[A-Za-z0-9:_-]+$ ]] || return 0
    herdr_sock_cmd "$sock" pane run "$pane" nvim >/dev/null || true
}

# Converge a work session onto the repo-major canon: one workspace per
# CTX_REPOS entry, each holding the role tabs editor/agents/logs in that
# order. nvim starts only in editor panes created here, never in adopted
# ones. Migration: a legacy role workspace labelled "editor" is RENAMED into
# the default repo's workspace (its running nvim survives); a default tab
# still labelled "1" is adopted as the editor tab. Legacy "agents"/"logs"
# workspaces are left for the user to close. Idempotent; no-op w/o socket.
herdr_ensure_layout() {
    local session="$1" ctx="$2" sock ws_json spec label dir wsid tab_json tabid pane create_json role default_label legacy_wsid
    sock="$(herdr_sock_for_session "$session")"
    [[ -S "$sock" ]] || return 0
    [[ "$ctx" == "Admin" ]] && return 0
    ws_json="$(herdr_sock_cmd "$sock" workspace list || true)"
    [[ -n "$ws_json" ]] || return 0
    default_label="$(ctx_default_repo_label "$ctx")"
    while IFS= read -r spec; do
        label="${spec%%=*}"
        dir="${spec#*=}"
        [[ -n "$label" && "$spec" == *=* ]] || continue
        wsid="$(jq -r --arg label "$label" \
            'first(.result.workspaces[]? | select(.label == $label) | .workspace_id) // empty' <<< "$ws_json" || true)"
        if [[ -z "$wsid" && "$label" == "$default_label" ]]; then
            legacy_wsid="$(jq -r 'first(.result.workspaces[]? | select(.label == "editor") | .workspace_id) // empty' <<< "$ws_json" || true)"
            if [[ -n "$legacy_wsid" ]]; then
                herdr_sock_cmd "$sock" workspace rename "$legacy_wsid" "$label" >/dev/null || true
                wsid="$legacy_wsid"
            fi
        fi
        if [[ -z "$wsid" ]]; then
            create_json="$(herdr_sock_cmd "$sock" workspace create --label "$label" --cwd "$dir" --no-focus || true)"
            wsid="$(jq -r '.result.workspace.workspace_id // empty' <<< "$create_json" || true)"
            [[ -n "$wsid" ]] || continue
            tabid="$(jq -r '.result.tab.tab_id // empty' <<< "$create_json" || true)"
            [[ -n "$tabid" ]] && herdr_sock_cmd "$sock" tab rename "$tabid" editor >/dev/null || true
            herdr_run_editor "$sock" "$(jq -r '.result.root_pane.pane_id // empty' <<< "$create_json" || true)"
        fi
        tab_json="$(herdr_sock_cmd "$sock" tab list --workspace "$wsid" || true)"
        [[ -n "$tab_json" ]] || continue
        for role in editor agents logs; do
            tabid="$(jq -r --arg label "$role" \
                'first(.result.tabs[]? | select(.label == $label) | .tab_id) // empty' <<< "$tab_json" || true)"
            [[ -n "$tabid" ]] && continue
            if [[ "$role" == "editor" ]]; then
                # Adopt an untouched default tab so tab order (and the
                # prefix+1..9 index mapping) stays editor/agents/logs.
                tabid="$(jq -r 'first(.result.tabs[]? | select(.label == "1" and .number == 1) | .tab_id) // empty' <<< "$tab_json" || true)"
                if [[ -n "$tabid" ]]; then
                    herdr_sock_cmd "$sock" tab rename "$tabid" editor >/dev/null || true
                    continue
                fi
            fi
            create_json="$(herdr_sock_cmd "$sock" tab create --workspace "$wsid" --label "$role" --cwd "$dir" --no-focus || true)"
            if [[ "$role" == "editor" ]]; then
                herdr_run_editor "$sock" "$(jq -r '.result.root_pane.pane_id // empty' <<< "$create_json" || true)"
            fi
        done
    done < <(ctx_repo_specs "$ctx")
}

# Focus (creating it first if missing) the herdr tab for a role. Role tabs
# act on the CURRENTLY FOCUSED workspace ("agents of whatever repo I'm in");
# legacy role-labelled workspaces and fresh sessions fall back to the default
# repo. repo:<label> focuses that repo's workspace instead. Silently a no-op
# while the socket is not up; the bootstrap armer owns the fresh-session
# window.
herdr_focus_role_tab() {
    local session="$1" ctx="$2" role="$3" sock ws_json wsid label dir tab_json tabid create_json
    sock="$(herdr_sock_for_session "$session")"
    [[ -S "$sock" ]] || return 0
    ws_json="$(herdr_sock_cmd "$sock" workspace list || true)"
    [[ -n "$ws_json" ]] || return 0
    if [[ "$ctx" == "Admin" ]]; then
        wsid="$(jq -r 'first(.result.workspaces[]? | select(.label == "term") | .workspace_id) // empty' <<< "$ws_json" || true)"
        [[ -n "$wsid" ]] && herdr_sock_cmd "$sock" workspace focus "$wsid" >/dev/null || true
        return 0
    fi
    # Self-heal: a session that predates the repo-major canon (or whose config
    # gained repos) has no default-repo workspace; converge it before landing.
    if ! jq -e --arg label "$(ctx_default_repo_label "$ctx")" \
        'any(.result.workspaces[]?; .label == $label)' <<< "$ws_json" >/dev/null 2>&1; then
        herdr_ensure_layout "$session" "$ctx"
        ws_json="$(herdr_sock_cmd "$sock" workspace list || true)"
        [[ -n "$ws_json" ]] || return 0
    fi
    if [[ "$role" == repo:* ]]; then
        label="${role#repo:}"
        wsid="$(jq -r --arg label "$label" \
            'first(.result.workspaces[]? | select(.label == $label) | .workspace_id) // empty' <<< "$ws_json" || true)"
        if [[ -z "$wsid" ]]; then
            dir="$(ctx_repo_dir "$ctx" "$label")" || return 0
            herdr_sock_cmd "$sock" workspace create --label "$label" --cwd "$dir" --focus >/dev/null || true
            return 0
        fi
        herdr_sock_cmd "$sock" workspace focus "$wsid" >/dev/null || true
        return 0
    fi
    wsid="$(jq -r 'first(.result.workspaces[]?
        | select(.focused)
        | select(.label | IN("editor", "agents", "logs", "term") | not)
        | .workspace_id) // empty' <<< "$ws_json" || true)"
    if [[ -z "$wsid" ]]; then
        wsid="$(jq -r --arg label "$(ctx_default_repo_label "$ctx")" \
            'first(.result.workspaces[]? | select(.label == $label) | .workspace_id) // empty' <<< "$ws_json" || true)"
    fi
    [[ -n "$wsid" ]] || return 0
    tab_json="$(herdr_sock_cmd "$sock" tab list --workspace "$wsid" || true)"
    [[ -n "$tab_json" ]] || return 0
    tabid="$(jq -r --arg label "$role" \
        'first(.result.tabs[]? | select(.label == $label) | .tab_id) // empty' <<< "$tab_json" || true)"
    if [[ -z "$tabid" ]]; then
        # No --cwd: herdr's new_cwd=follow default inherits the workspace dir,
        # which is also right for ad-hoc task workspaces we don't know about.
        create_json="$(herdr_sock_cmd "$sock" tab create --workspace "$wsid" --label "$role" --focus || true)"
        if [[ "$role" == "editor" ]]; then
            herdr_run_editor "$sock" "$(jq -r '.result.root_pane.pane_id // empty' <<< "$create_json" || true)"
        fi
        return 0
    fi
    herdr_sock_cmd "$sock" tab focus "$tabid" >/dev/null || true
}

# Land on a role from outside the card: herdr tab focus over the session
# socket, or tmux select-window in the fallback backend.
deep_link_role() {
    local ctx="$1" role="$2" session window repo cur
    session="$(role_session_name "$ctx" "$role")" || return 0
    if [[ "${SESSION_BACKEND:-herdr}" == "herdr" ]] && command -v herdr >/dev/null 2>&1; then
        herdr_focus_role_tab "$session" "$ctx" "$role"
    elif command -v tmux >/dev/null 2>&1; then
        if [[ "$ctx" == "Admin" ]]; then
            window=term
        elif [[ "$role" == repo:* ]]; then
            window="${role#repo:}/editor"
        else
            cur="$(tmux display-message -p -t "$session" '#{window_name}' 2>/dev/null || true)"
            repo="${cur%%/*}"
            [[ -n "$repo" && "$cur" == */* ]] || repo="$(ctx_default_repo_label "$ctx")"
            window="$repo/$role"
        fi
        tmux select-window -t "${session}:${window}" 2>/dev/null \
            || tmux select-window -t "${session}:${role}" 2>/dev/null || true
    fi
}

# Tear down a herdr session that THIS launch just created but whose terminal
# window never appeared. An orphaned zero-content server left behind by a
# failed spawn is exactly the state observed to wedge the next attach
# (2026-07-04: UP-logs/UP-agents blank cards). Only ever called when the
# session did not exist before the launch, so nothing of the user's is lost.
reap_fresh_herdr_session() {
    local session="$1"
    herdr_session_name_valid "$session" || return 0
    command -v herdr >/dev/null 2>&1 || return 0
    log_line "reaping fresh herdr session after spawn timeout session=$session"
    timeout 3 herdr session stop "$session" >/dev/null 2>&1 || true
    timeout 3 herdr session delete "$session" >/dev/null 2>&1 || true
}

herdr_session_exists() {
    local session="$1" sessions_json
    herdr_session_name_valid "$session" || return 1
    sessions_json="$(herdr session list --json 2>/dev/null)" || return 1
    jq -e --arg session "$session" \
        'any(.sessions[]?; .name == $session)' \
        <<< "$sessions_json" >/dev/null 2>&1
}

# Bootstrap a FRESH work session in the background once its socket appears:
# adopt w1 as the default repo's workspace (its default tab, a fresh shell,
# becomes the editor tab running nvim), converge the full repo/tab layout,
# then land on the requested role. Every step is idempotent and best-effort
# so a half-bootstrapped session converges on the next open.
arm_herdr_bootstrap() {
    local session="$1" ctx="$2" role="$3" sock label
    herdr_session_name_valid "$session" || return 0
    sock="$(herdr_sock_for_session "$session")"
    label="$(ctx_default_repo_label "$ctx")"
    (
        local pane tabid
        for _ in $(seq 1 50); do
            [[ -S "$sock" ]] && break
            sleep 0.2
        done
        [[ -S "$sock" ]] || exit 0
        sleep 0.5
        herdr_sock_cmd "$sock" workspace rename w1 "$label" >/dev/null || true
        [[ "$ctx" == "Admin" ]] && exit 0
        # herdr's socket CLI replies in JSON (verified live on herdr 0.7.1):
        # tab list → {"result":{"tabs":[{"tab_id":"w1:t1",...}]}}
        tabid="$(herdr_sock_cmd "$sock" tab list --workspace w1 \
            | jq -r '.result.tabs[0].tab_id // empty' 2>/dev/null || true)"
        [[ -n "$tabid" ]] && herdr_sock_cmd "$sock" tab rename "$tabid" editor >/dev/null || true
        pane="$(herdr_sock_cmd "$sock" pane list --workspace w1 \
            | jq -r '.result.panes[0].pane_id // empty' 2>/dev/null || true)"
        herdr_run_editor "$sock" "$pane"
        herdr_ensure_layout "$session" "$ctx"
        herdr_focus_role_tab "$session" "$ctx" "$role"
    ) >/dev/null 2>&1 &
}

try_herdr_attach() {
    local session="$1" ctx="$2" role="$3" fresh=0 rc started ended
    herdr_session_name_valid "$session" || {
        log_line "invalid herdr session name session=$session role=$role"
        return 1
    }
    if ! herdr_session_exists "$session"; then
        fresh=1
    fi
    if ((fresh)); then
        arm_herdr_bootstrap "$session" "$ctx" "$role"
    else
        herdr_ensure_layout "$session" "$ctx"
        herdr_focus_role_tab "$session" "$ctx" "$role"
    fi
    started="$(date +%s)"
    set +e
    # herdr refuses to nest; this attach may run from a shell that already
    # lives inside a herdr pane, so strip the inherited markers.
    env -u HERDR_ENV -u HERDR_PANE_ID -u HERDR_SESSION -u HERDR_SOCKET_PATH \
        -u HERDR_TAB_ID -u HERDR_WORKSPACE_ID \
        HERDR_STARTUP_CWD="$PWD" herdr --session "$session"
    rc=$?
    set -e
    ended="$(date +%s)"
    if [[ "$rc" -eq 0 ]]; then
        exit 0
    fi
    if ((ended - started > 15)); then
        # herdr ran long enough to be a real working session; a late crash must
        # close the card, not teleport it into a stale same-named tmux session.
        log_line "herdr exited rc=$rc after $((ended - started))s session=$session role=$role; closing card"
        exit "$rc"
    fi
    log_line "herdr failed rc=$rc session=$session role=$role; falling back to tmux"
    return "$rc"
}

run_tmux_role() {
    local ctx="$1" role="$2" dir session
    if ! ctx="$(normalize_context "$ctx")"; then
        printf 'unknown context: %s\n' "$ctx" >&2
        exit 2
    fi
    role="$(normalize_role "$role")"
    case "$role" in
        editor|agents|logs|term|repo:*) ;;
        *) printf 'unknown terminal role: %s\n' "$role" >&2; exit 2 ;;
    esac
    unset TMUX TMUX_PANE
    dir="$(ctx_default_repo_dir "$ctx")"
    cd "$dir" 2>/dev/null || cd "$HOME"
    printf '\033]0;%s\007' "$(terminal_title "$ctx" "$role")"
    session="$(role_session_name "$ctx" "$role")"
    if [[ "${SESSION_BACKEND:-herdr}" == "herdr" ]]; then
        if command -v herdr >/dev/null 2>&1; then
            try_herdr_attach "$session" "$ctx" "$role" || true
        else
            log_line "SESSION_BACKEND=herdr but herdr missing; falling back to tmux session=$session role=$role"
        fi
    fi
    tmux_attach_work "$session" "$ctx" "$role"
}

app_id_for_comms_app() {
    case "$1" in
        slack) printf 'slack\n' ;;
        telegram) printf 'org.telegram.desktop\n' ;;
        discord) printf 'discord\n' ;;
        *) return 1 ;;
    esac
}

# Returns nonzero when the app is not installed (caller then skips waiting on it).
launch_comms_app() {
    case "$1" in
        slack)
            command -v slack >/dev/null 2>&1 || return 1
            spawn_detached slack
            ;;
        telegram)
            if command -v Telegram >/dev/null 2>&1; then
                spawn_detached Telegram
            elif command -v telegram-desktop >/dev/null 2>&1; then
                spawn_detached telegram-desktop
            else
                return 1
            fi
            ;;
        discord)
            command -v discord >/dev/null 2>&1 || return 1
            spawn_detached discord
            ;;
        *)
            return 1
            ;;
    esac
}

window_is_floating() {
    local id="$1" result
    is_uint "$id" || return 0
    # jq's // also replaces a legitimate `false`, so it can't provide the
    # missing-window default here.
    result="$(niri msg --json windows | jq -r --argjson id "$id" \
        '[.[] | select(.id == $id) | .is_floating] | if length == 0 then true else first end')"
    [[ "$result" == "true" ]]
}

right_column_first_id() {
    local workspace_id="$1" current_col="$2"
    is_uint "$workspace_id" && is_uint "$current_col" || return 1
    niri msg --json windows | jq -r --argjson ws "$workspace_id" --argjson col "$current_col" '
        [.[] | select(.workspace_id == $ws and .is_floating == false and (.layout.pos_in_scrolling_layout[0] // 0) > $col)]
        | sort_by(.layout.pos_in_scrolling_layout[0], .layout.pos_in_scrolling_layout[1])
        | first(.[] | .id) // empty
    '
}

# Break up every multi-window tiled column on the workspace so each window
# sits in its own column. The stack builder assumes singleton columns; Hyper+V
# must converge from ANY starting arrangement, including partial stacks.
flatten_workspace_columns() {
    local workspace_id="$1" target
    is_uint "$workspace_id" || return 0
    for _ in 1 2 3 4 5 6 7 8; do
        target="$(niri msg --json windows | jq -r --argjson ws "$workspace_id" '
            [.[] | select(.workspace_id == $ws and .is_floating == false and .layout.pos_in_scrolling_layout != null)]
            | group_by(.layout.pos_in_scrolling_layout[0])
            | map(select(length > 1))
            | if length == 0 then empty
              else (.[0] | sort_by(.layout.pos_in_scrolling_layout[1]) | .[-1].id)
              end')"
        is_uint "$target" || return 0
        niri_action focus-window --id "$target" || return 0
        niri_action expel-window-from-column || return 0
        sleep 0.1
    done
}

restore_comms() {
    local app app_id id ids=() present_apps=() stacking_ids=() workspace_id col right_id first_id first_col same_col height
    for app in slack telegram discord; do
        app_id="$(app_id_for_comms_app "$app")"
        id="$(window_id_by_app_id "$app_id")"
        if [[ -n "$id" ]]; then
            present_apps+=("$app")
        elif launch_comms_app "$app"; then
            present_apps+=("$app")
        else
            log_line "comms app $app not installed; skipping"
        fi
    done
    for app in ${present_apps[@]+"${present_apps[@]}"}; do
        app_id="$(app_id_for_comms_app "$app")"
        id="$(window_id_by_app_id "$app_id")"
        if [[ -z "$id" ]]; then
            id="$(wait_for_app_id "$app_id" 10 || true)"
        fi
        if [[ -n "$id" ]]; then
            ids+=("$id")
            niri_action move-window-to-workspace --window-id "$id" --focus false "$COMMS_WORKSPACE" || true
        fi
    done
    ctx_focus_workspace "$COMMS_OUTPUT" "$COMMS_WORKSPACE"
    ((${#ids[@]} > 0)) || return 0
    workspace_id="$(ctx_workspace_id_from_json "$(niri msg --json workspaces)" "$COMMS_WORKSPACE")"
    is_uint "$workspace_id" || return 0
    for id in "${ids[@]}"; do
        if ! window_is_floating "$id"; then
            stacking_ids+=("$id")
        fi
    done
    ((${#stacking_ids[@]} > 0)) || return 0
    first_id="${stacking_ids[0]}"
    # Already one shared column? Then only heights may need fixing — skip the
    # tear-down/rebuild churn.
    same_col=1
    first_col="$(column_index_for_id "$first_id" || true)"
    if is_uint "$first_col"; then
        for id in "${stacking_ids[@]:1}"; do
            [[ "$(column_index_for_id "$id" || true)" == "$first_col" ]] || { same_col=0; break; }
        done
    else
        same_col=0
    fi
    if ((same_col == 0)); then
        flatten_workspace_columns "$workspace_id"
        for i in "${!stacking_ids[@]}"; do
            focus_window_id "${stacking_ids[$i]}"
            niri_action move-column-to-index "$((i + 1))" || true
        done
        focus_window_id "$first_id"
        niri_action set-column-width "100%" || true
        for id in "${stacking_ids[@]:1}"; do
            # The layout may lag behind the moves above; re-check a few times
            # before giving up on stacking this window.
            for _ in 1 2 3 4; do
                col="$(column_index_for_id "$first_id")"
                is_uint "$col" || break
                right_id="$(right_column_first_id "$workspace_id" "$col")"
                if [[ "$right_id" == "$id" ]]; then
                    focus_window_id "$first_id"
                    niri_action consume-window-into-column || true
                    break
                fi
                sleep 0.1
            done
        done
    fi
    height=$((100 / ${#stacking_ids[@]}))
    for id in "${stacking_ids[@]}"; do
        niri_action set-window-height --id "$id" "${height}%" || true
    done
    focus_window_id "$first_id"
}

# Scratch workspace: one browser card + one PLAIN terminal (no herdr/tmux
# attach — just the login shell). Converges like a context open.
open_scratch() {
    local docs_id term_id app_id ws_id cur_ws
    ctx_focus_workspace "$MAIN_OUTPUT" "$SCRATCH_WORKSPACE"
    docs_id="$(focus_or_launch_browser scratch docs || true)"
    app_id="$APP_PREFIX.scratch.term"
    term_id="$(window_id_by_app_id "$app_id")"
    if [[ -z "$term_id" ]]; then
        case "$CONTEXT_TERMINAL" in
            ghostty)
                command -v ghostty >/dev/null 2>&1 || die "ghostty is not installed"
                spawn_detached ghostty --gtk-single-instance=false --class="$app_id" --title=scratch
                ;;
            alacritty)
                command -v alacritty >/dev/null 2>&1 || die "alacritty is not installed"
                spawn_detached alacritty --class "$app_id,$app_id" --title scratch
                ;;
            *)
                die "unsupported NIRI_CONTEXT_TERMINAL=$CONTEXT_TERMINAL; use ghostty or alacritty so app-id can be detected"
                ;;
        esac
        term_id="$(wait_for_app_id "$app_id" 10 || true)"
    else
        # Re-home a scratch terminal that drifted to another workspace.
        ws_id="$(ctx_workspace_id_from_json "$(niri msg --json workspaces)" "$SCRATCH_WORKSPACE")"
        cur_ws="$(window_workspace_id_for_id "$term_id" || true)"
        if is_uint "$ws_id" && [[ "$cur_ws" != "$ws_id" ]]; then
            niri_action move-window-to-workspace --window-id "$term_id" --focus false "$SCRATCH_WORKSPACE" || true
        fi
    fi
    flatten_tracked_cards "$SCRATCH_WORKSPACE" "$docs_id" "$term_id"
    move_column_to_index_if_needed "$docs_id" 1 "$SCRATCH_WORKSPACE"
    move_column_to_index_if_needed "$term_id" 2 "$SCRATCH_WORKSPACE"
    ctx_focus_workspace "$MAIN_OUTPUT" "$SCRATCH_WORKSPACE"
    if [[ -n "$term_id" ]]; then
        focus_window_id "$term_id"
    fi
}

devtools_here() {
    local windows_json workspaces_json focused_id focused_ws_id focused_ws ctx
    windows_json="$(niri msg --json windows)"
    focused_id="$(jq -r 'first(.[] | select(.is_focused) | .id) // empty' <<< "$windows_json")"
    is_uint "$focused_id" || return 0
    focused_ws_id="$(jq -r --argjson id "$focused_id" 'first(.[] | select(.id == $id) | .workspace_id) // empty' <<< "$windows_json")"
    is_uint "$focused_ws_id" || return 0
    workspaces_json="$(niri msg --json workspaces)"
    focused_ws="$(jq -r --argjson ws "$focused_ws_id" 'first(.[] | select(.id == $ws) | .name // empty) // empty' <<< "$workspaces_json")"
    if ! ctx="$(context_from_workspace "$focused_ws")"; then
        return 0
    fi
    if [[ "$ctx" == "Admin" ]]; then
        # Admin has no devtools workspace.
        return 0
    fi
    niri_action move-window-to-workspace --window-id "$focused_id" --focus false "${ctx}-devtools" || true
    ctx_focus_workspace "$TOP_OUTPUT" "${ctx}-devtools"
    ctx_focus_workspace "$MAIN_OUTPUT" "$ctx"
}

spotify_window_id() {
    window_id_by_app_id "Spotify"
}

launch_spotify() {
    if command -v spotify-launcher >/dev/null 2>&1; then
        spawn_detached spotify-launcher
    elif command -v spotify >/dev/null 2>&1; then
        spawn_detached spotify
    else
        die "spotify-launcher or spotify is not installed"
    fi
}

focus_spotify() {
    local id
    id="$(spotify_window_id)"
    if [[ -z "$id" ]]; then
        launch_spotify
        id="$(wait_for_app_id "Spotify" 20 || true)"
    fi
    [[ -n "$id" ]] || return 0
    # Moving to the NAMED workspace is sufficient and deterministic; a
    # follow-up move-window-to-monitor would re-move the window onto whatever
    # workspace happens to be active on that output.
    niri_action move-window-to-workspace --window-id "$id" --focus false "$TOP_WORKSPACE" || true
    ctx_focus_workspace "$TOP_OUTPUT" "$TOP_WORKSPACE"
    focus_window_id "$id"
}

top_ambient() {
    ctx_focus_workspace "$TOP_OUTPUT" "$TOP_WORKSPACE"
    ctx_focus_monitor "$MAIN_OUTPUT"
}

focus_only_when_locked() {
    local cmd="$1" ctx="${2:-}" role="${3:-}" id
    log_line "lock busy; focus-only cmd=$cmd ctx=$ctx role=$role"
    case "$cmd" in
        open)
            [[ -n "$ctx" ]] || return 0
            ctx_focus_workspace "$MAIN_OUTPUT" "$ctx"
            case "$role" in
                docs|output)
                    if id="$(valid_browser_cache_id "$ctx" "$role")"; then
                        focus_window_id "$id"
                    fi
                    ;;
                editor|agents|logs|term|repo:*)
                    id="$(terminal_window_id "$ctx" "$role")"
                    [[ -n "$id" ]] && focus_window_id "$id"
                    ;;
            esac
            ;;
        scratch)
            ctx_focus_workspace "$MAIN_OUTPUT" "$SCRATCH_WORKSPACE"
            id="$(window_id_by_app_id "$APP_PREFIX.scratch.term")"
            [[ -n "$id" ]] && focus_window_id "$id"
            ;;
        comms)
            ctx_focus_workspace "$COMMS_OUTPUT" "$COMMS_WORKSPACE"
            id="$(window_id_by_app_id slack)"
            [[ -n "$id" ]] && focus_window_id "$id"
            ;;
        spotify)
            id="$(spotify_window_id)"
            if [[ -n "$id" ]]; then
                ctx_focus_workspace "$TOP_OUTPUT" "$TOP_WORKSPACE"
                focus_window_id "$id"
            fi
            ;;
        devtools-here)
            return 0
            ;;
    esac
}

with_global_lock() {
    local cmd="$1" ctx="${2:-}" role="${3:-}"
    mkdir -p "$(dirname -- "$LOCK_FILE")"
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
        focus_only_when_locked "$cmd" "$ctx" "$role"
        exit 0
    fi
}

active_workspace_name_on_output() {
    local output="$1"
    niri msg --json workspaces | ctx_active_workspace_on_output_from_json "$output"
}

# True when a dispatcher command currently holds the global lock; the watcher
# must stay out of the way while scripted focus sequences run.
global_lock_is_busy() {
    local fd
    mkdir -p "$(dirname -- "$LOCK_FILE")"
    exec {fd}>"$LOCK_FILE" 2>/dev/null || return 1
    if flock -n "$fd"; then
        flock -u "$fd"
        exec {fd}>&-
        return 1
    fi
    exec {fd}>&-
    return 0
}

watch_apply_top_follow() {
    local target="$1" now
    [[ -n "$target" ]] || return 0
    if global_lock_is_busy; then
        return 0
    fi
    if [[ "$(active_workspace_name_on_output "$TOP_OUTPUT")" == "$target" ]]; then
        return 0
    fi
    now="$(date +%s%3N)"
    WATCH_IGNORE_UNTIL=$((now + 700))
    ctx_focus_workspace "$TOP_OUTPUT" "$target"
    ctx_focus_monitor "$MAIN_OUTPUT"
}

watch_consider_focus() {
    local focused_id="$1" now app_id ws_id ws_name ws_output ctx target=""
    is_uint "$focused_id" || return 0
    now="$(date +%s%3N)"
    ((now >= WATCH_IGNORE_UNTIL)) || return 0
    [[ "${TOP_FOLLOW:-devtools}" != "off" ]] || return 0
    app_id="${WIN_APP[$focused_id]:-}"
    ws_id="${WIN_WS[$focused_id]:-}"
    [[ -n "$ws_id" ]] || return 0
    ws_name="${WS_NAME[$ws_id]:-}"
    ws_output="${WS_OUTPUT[$ws_id]:-}"
    [[ "$ws_output" == "$MAIN_OUTPUT" ]] || return 0
    ctx="$(context_from_workspace "$ws_name" 2>/dev/null)" || return 0
    [[ "$ctx" != "Admin" ]] || return 0
    if [[ "$app_id" == "helium" && "${TOP_FOLLOW:-devtools}" == "devtools" ]]; then
        target="${ctx}-devtools"
    elif [[ "$app_id" != "helium" && "${TOP_FOLLOW:-devtools}" == "ambient" ]]; then
        target="$TOP_WORKSPACE"
    fi
    watch_apply_top_follow "$target"
}

watch_daemon() {
    local backoff=1 line type now focused_id app_id ws_id ws_name ws_output target
    if [[ -z "${NIRI_SOCKET:-}" ]]; then
        log_line "watch exit: NIRI_SOCKET unset"
        exit 0
    fi
    if ! niri msg --json workspaces >/dev/null 2>&1; then
        log_line "watch exit: niri socket unreachable"
        exit 0
    fi
    declare -A WIN_APP=()
    declare -A WIN_WS=()
    declare -A WS_NAME=()
    declare -A WS_OUTPUT=()
    WATCH_IGNORE_UNTIL=0
    while true; do
        while IFS= read -r line; do
            backoff=1
            type="$(jq -r 'keys[0] // empty' <<< "$line" 2>/dev/null || true)"
            case "$type" in
                WorkspacesChanged)
                    WS_NAME=()
                    WS_OUTPUT=()
                    while IFS=$'\t' read -r ws_id ws_name ws_output; do
                        [[ -n "$ws_id" ]] || continue
                        WS_NAME[$ws_id]="$ws_name"
                        WS_OUTPUT[$ws_id]="$ws_output"
                    done < <(jq -r '.WorkspacesChanged.workspaces[] | [.id, (.name // ""), (.output // "")] | @tsv' <<< "$line")
                    ;;
                WindowsChanged)
                    WIN_APP=()
                    WIN_WS=()
                    while IFS=$'\t' read -r focused_id app_id ws_id; do
                        [[ -n "$focused_id" ]] || continue
                        WIN_APP[$focused_id]="$app_id"
                        WIN_WS[$focused_id]="$ws_id"
                    done < <(jq -r '.WindowsChanged.windows[] | [.id, (.app_id // ""), (.workspace_id // "")] | @tsv' <<< "$line")
                    ;;
                WindowOpenedOrChanged)
                    focused_id="$(jq -r '.WindowOpenedOrChanged.window.id // empty' <<< "$line")"
                    if [[ -n "$focused_id" ]]; then
                        WIN_APP[$focused_id]="$(jq -r '.WindowOpenedOrChanged.window.app_id // ""' <<< "$line")"
                        WIN_WS[$focused_id]="$(jq -r '.WindowOpenedOrChanged.window.workspace_id // ""' <<< "$line")"
                        # niri folds a focus change into this event when it
                        # coincides with a title/workspace change, so a
                        # WindowFocusChanged may never arrive for it.
                        if [[ "$(jq -r '.WindowOpenedOrChanged.window.is_focused // false' <<< "$line")" == "true" ]]; then
                            watch_consider_focus "$focused_id" || true
                        fi
                    fi
                    ;;
                WindowClosed)
                    focused_id="$(jq -r '.WindowClosed.id // empty' <<< "$line")"
                    if is_uint "$focused_id"; then
                        unset "WIN_APP[$focused_id]" "WIN_WS[$focused_id]" 2>/dev/null || true
                    fi
                    ;;
                WindowFocusChanged)
                    focused_id="$(jq -r '.WindowFocusChanged.id // empty' <<< "$line")"
                    watch_consider_focus "$focused_id" || true
                    ;;
            esac
        done < <(niri msg --json event-stream)
        log_line "watch event-stream ended; reconnecting in ${backoff}s"
        sleep "$backoff"
        ((backoff < 30)) && backoff=$((backoff * 2))
    done
}

startup_sync() {
    local workspaces_json has_up
    for _ in {1..75}; do
        workspaces_json="$(niri msg --json workspaces 2>/dev/null || true)"
        if [[ -n "$workspaces_json" ]]; then
            has_up="$(jq -r --arg output "$MAIN_OUTPUT" 'any(.[]; .output == $output and .name == "UP")' <<< "$workspaces_json")"
            if [[ "$has_up" == "true" ]]; then
                ctx_focus_workspace "$MAIN_OUTPUT" "UP"
                return 0
            fi
        fi
        sleep 0.2
    done
    log_line "startup timeout waiting for UP on $MAIN_OUTPUT"
}

doctor_line() {
    local level="$1" message="$2"
    printf '%s %s\n' "$level" "$message"
}

doctor() {
    local failures=0 workspaces_json output stale_count keybinds niri_ctx_path unit_state helium_ok=0
    local herdr_config_target herdr_sessions_json herdr_session_names spec label dir
    if command -v niri >/dev/null 2>&1; then
        if niri validate -c "$REPO_ROOT/.config/niri/config.kdl" >/dev/null 2>&1; then
            doctor_line PASS "niri validate"
        else
            doctor_line FAIL "niri validate"
            failures=$((failures + 1))
        fi
    else
        doctor_line FAIL "niri binary missing"
        failures=$((failures + 1))
    fi
    if [[ -n "${NIRI_SOCKET:-}" ]] && workspaces_json="$(niri msg --json workspaces 2>/dev/null)"; then
        doctor_line PASS "NIRI_SOCKET reachable"
    else
        doctor_line FAIL "NIRI_SOCKET unreachable"
        failures=$((failures + 1))
        workspaces_json="[]"
    fi
    for output in "$MAIN_OUTPUT" "$TOP_OUTPUT" "$COMMS_OUTPUT"; do
        if jq -e --arg output "$output" 'any(.[]; .output == $output)' <<< "$workspaces_json" >/dev/null; then
            doctor_line PASS "output $output present"
        elif [[ "$output" == "$MAIN_OUTPUT" ]]; then
            doctor_line FAIL "output $output missing"
            failures=$((failures + 1))
        else
            doctor_line WARN "output $output missing"
        fi
    done
    for ctx in UP Webroot Sealant Side Admin; do
        if [[ -z "${CTX_REPOS[$ctx]:-}" ]]; then
            doctor_line FAIL "CTX_REPOS[$ctx] unset"
            failures=$((failures + 1))
            continue
        fi
        while IFS= read -r spec; do
            label="${spec%%=*}"
            dir="${spec#*=}"
            if [[ -z "$label" || "$spec" != *=* ]]; then
                doctor_line FAIL "CTX_REPOS[$ctx] malformed entry '$spec'"
                failures=$((failures + 1))
            elif [[ -d "$dir" ]]; then
                doctor_line PASS "CTX_REPOS[$ctx] $label=$dir"
            else
                doctor_line FAIL "CTX_REPOS[$ctx] $label=$dir missing"
                failures=$((failures + 1))
            fi
        done < <(ctx_repo_specs "$ctx")
    done
    for bin in jq tmux "$CONTEXT_TERMINAL"; do
        if command -v "$bin" >/dev/null 2>&1; then
            doctor_line PASS "binary $bin"
        else
            doctor_line FAIL "binary $bin missing"
            failures=$((failures + 1))
        fi
    done
    if [[ -x "$HELIUM_BIN" ]] || command -v helium >/dev/null 2>&1; then
        helium_ok=1
    fi
    if ((helium_ok)); then
        doctor_line PASS "helium available"
    else
        doctor_line FAIL "helium missing"
        failures=$((failures + 1))
    fi
    if command -v spotify-launcher >/dev/null 2>&1 || command -v spotify >/dev/null 2>&1; then
        doctor_line INFO "spotify launcher available"
    else
        doctor_line INFO "spotify launcher missing"
    fi
    if [[ "${SESSION_BACKEND:-herdr}" == "herdr" ]]; then
        if command -v herdr >/dev/null 2>&1; then
            doctor_line PASS "binary herdr"
        else
            doctor_line FAIL "SESSION_BACKEND=herdr but herdr missing"
            failures=$((failures + 1))
        fi
    elif command -v herdr >/dev/null 2>&1; then
        doctor_line INFO "herdr available; SESSION_BACKEND=${SESSION_BACKEND:-tmux}"
    else
        doctor_line INFO "herdr missing; SESSION_BACKEND=${SESSION_BACKEND:-tmux}"
    fi
    if [[ -L "$HOME/.config/herdr/config.toml" ]]; then
        herdr_config_target="$(readlink -f "$HOME/.config/herdr/config.toml" || true)"
        if [[ "$herdr_config_target" == "$REPO_ROOT/.config/herdr/config.toml" ]]; then
            doctor_line PASS "herdr config.toml linked into repo"
        else
            doctor_line WARN "herdr config.toml symlink points to ${herdr_config_target:-unknown}"
        fi
    elif [[ -e "$HOME/.config/herdr/config.toml" ]]; then
        doctor_line WARN "herdr config.toml is a real file, not repo-managed"
    else
        doctor_line WARN "herdr config.toml missing"
    fi
    if command -v herdr >/dev/null 2>&1; then
        if herdr_sessions_json="$(herdr session list --json 2>/dev/null)"; then
            herdr_session_names="$(jq -r '[.sessions[]?.name] | join(", ")' <<< "$herdr_sessions_json" 2>/dev/null || true)"
            doctor_line INFO "herdr sessions: ${herdr_session_names:-none}"
        else
            doctor_line WARN "herdr session list failed"
        fi
    fi
    if command -v systemctl >/dev/null 2>&1; then
        unit_state="$(systemctl --user is-active niri-ctx-watch 2>/dev/null || true)"
        doctor_line INFO "systemd niri-ctx-watch active=$unit_state"
    else
        doctor_line INFO "systemctl missing"
    fi
    stale_count="$(find "$HOME/.cache" -maxdepth 1 -type f -name 'niri-browser-*' 2>/dev/null | wc -l)"
    if [[ "$stale_count" -gt 0 ]]; then
        doctor_line WARN "legacy browser cache files present in ~/.cache; remove niri-browser-* after migration"
    else
        doctor_line PASS "no legacy browser cache files"
    fi
    keybinds="$REPO_ROOT/.config/niri/cfg/keybinds.kdl"
    niri_ctx_path="$HOME/.local/bin/niri-ctx"
    if [[ -e "$niri_ctx_path" ]]; then
        if [[ -f "$keybinds" ]] && grep -q 'niri-ctx' "$keybinds"; then
            doctor_line PASS "keybinds reference niri-ctx"
        elif [[ -f "$keybinds" ]]; then
            doctor_line FAIL "keybinds do not reference niri-ctx yet"
            failures=$((failures + 1))
        else
            doctor_line FAIL "keybinds file missing"
            failures=$((failures + 1))
        fi
    else
        doctor_line FAIL "$niri_ctx_path missing"
        failures=$((failures + 1))
    fi
    return "$failures"
}

handle_open() {
    local ctx="${1:-}" role="${2:-all}"
    [[ -n "$ctx" ]] || die "open requires a context"
    if [[ "$ctx" == "current" ]]; then
        ctx="$(current_context)"
    elif ! ctx="$(normalize_context "$ctx")"; then
        die "unknown context: $ctx"
    fi
    if ! role="$(normalize_role "$role")"; then
        die "unknown role: ${2:-all}"
    fi
    with_global_lock open "$ctx" "$role"
    open_role "$ctx" "$role"
}

main() {
    local subcmd="${1:-}"
    log_line "invoke args=$(printf '%q ' "$@")"
    case "$subcmd" in
        --tmux-role)
            shift
            [[ $# -eq 2 ]] || die "--tmux-role requires <ctx> <role>"
            run_tmux_role "$1" "$2"
            ;;
        open)
            shift
            handle_open "$@"
            ;;
        scratch)
            shift
            [[ $# -eq 0 ]] || die "scratch takes no arguments"
            with_global_lock scratch
            open_scratch
            ;;
        comms)
            shift
            [[ $# -eq 0 ]] || die "comms takes no arguments"
            with_global_lock comms
            restore_comms
            ;;
        devtools-here)
            shift
            [[ $# -eq 0 ]] || die "devtools-here takes no arguments"
            with_global_lock devtools-here
            devtools_here
            ;;
        top-ambient)
            shift
            [[ $# -eq 0 ]] || die "top-ambient takes no arguments"
            top_ambient
            ;;
        spotify)
            shift
            [[ $# -eq 0 ]] || die "spotify takes no arguments"
            with_global_lock spotify
            focus_spotify
            ;;
        watch)
            shift
            [[ $# -eq 0 ]] || die "watch takes no arguments"
            watch_daemon
            ;;
        startup)
            shift
            [[ $# -eq 0 ]] || die "startup takes no arguments"
            startup_sync
            ;;
        doctor)
            shift
            [[ $# -eq 0 ]] || die "doctor takes no arguments"
            doctor
            ;;
        -h|--help|'')
            usage
            [[ -n "$subcmd" ]]
            ;;
        *)
            usage
            exit 2
            ;;
    esac
}

main "$@"
