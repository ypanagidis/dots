    window-rule {
        geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
    }

    // Comms app IDs captured from `niri msg --json windows` on 2026-07-02:
    // Slack: app_id "slack"; Discord: app_id "discord".
    // Telegram: app_id "org.telegram.desktop".
    window-rule {
        match app-id="slack"
        open-on-output "HDMI-A-1"
        open-on-workspace "comms"
    }

    window-rule {
        match app-id="discord"
        open-on-output "HDMI-A-1"
        open-on-workspace "comms"
    }

    window-rule {
        match app-id="org.telegram.desktop"
        open-on-output "HDMI-A-1"
        open-on-workspace "comms"
    }

    // Spotify app ID captured from `niri msg --json windows` on 2026-07-03:
    // Spotify: app_id "Spotify".
    window-rule {
        match app-id="Spotify"
        open-on-output "DP-2"
        open-on-workspace "top-ambient"
    }

     // if you use steam you will probably like these
    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }
