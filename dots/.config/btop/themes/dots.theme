# "dots" btop theme: the Kanagawa Wave palette shared with the terminals
# (dots/.config/ghostty/themes/t3-kanagawa) and T3 Code.
#   bg #1f1f28  fg #dcd7ba  border #363646  selection #223249
#   red #e46876  green #98bb6c  yellow #e6c384  blue #7e9cd8  violet #957fb8

# Main background and foreground
theme[main_bg]="#1f1f28"
theme[main_fg]="#dcd7ba"

# Title color for boxes
theme[title]="#dcd7ba"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#7e9cd8"

# Background and foreground of selected item in processes box
theme[selected_bg]="#223249"
theme[selected_fg]="#dcd7ba"

# Color of inactive/disabled text
theme[inactive_fg]="#727169"

# Color of text appearing on top of graphs
theme[graph_text]="#c8c093"

# Background color of the percentage meters
theme[meter_bg]="#363646"

# Misc colors for processes box (tree branches etc.)
theme[proc_misc]="#7e9cd8"

# Box outline colors
theme[cpu_box]="#363646"
theme[mem_box]="#363646"
theme[net_box]="#363646"
theme[proc_box]="#363646"

# Divider line color
theme[div_line]="#363646"

# Temperature graph gradient (cool -> hot)
theme[temp_start]="#98bb6c"
theme[temp_mid]="#e6c384"
theme[temp_end]="#e46876"

# CPU graph gradient (idle -> busy)
theme[cpu_start]="#98bb6c"
theme[cpu_mid]="#e6c384"
theme[cpu_end]="#e46876"

# Mem/Disk free meter
theme[free_start]="#76946a"
theme[free_mid]="#98bb6c"
theme[free_end]="#c8c093"

# Mem/Disk cached meter
theme[cached_start]="#6a9589"
theme[cached_mid]="#7fb4ca"
theme[cached_end]="#dcd7ba"

# Mem/Disk available meter
theme[available_start]="#c0a36e"
theme[available_mid]="#e6c384"
theme[available_end]="#dcd7ba"

# Mem/Disk used meter
theme[used_start]="#c34043"
theme[used_mid]="#e46876"
theme[used_end]="#dcd7ba"

# Download graph gradient
theme[download_start]="#7e9cd8"
theme[download_mid]="#7fb4ca"
theme[download_end]="#957fb8"

# Upload graph gradient
theme[upload_start]="#957fb8"
theme[upload_mid]="#938aa9"
theme[upload_end]="#dcd7ba"

# Process box gradient (color by cpu usage)
theme[process_start]="#7e9cd8"
theme[process_mid]="#957fb8"
theme[process_end]="#e46876"
