font-family = MesloLGS Nerd Font Mono
font-size = 14
adjust-cell-height = 25%
copy-on-select = clipboard
theme = Ayu Mirage
background-opacity = 1
background-blur = false
window-padding-x = 10
window-padding-y = 8
# No titlebar. Default (auto) means server-side decorations under KDE;
# niri never drew them, which is why this was never needed before.
window-decoration = none
fullscreen = true

# Let Herdr use Ctrl-Shift-J for next-agent navigation.
keybind = ctrl+shift+j=unbind
