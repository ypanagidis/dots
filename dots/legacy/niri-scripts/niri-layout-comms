#!/usr/bin/env bash
set -euo pipefail

VERTICAL_OUTPUT="HDMI-A-1"
COMMS_WS="comms"

window_id_for() {
    local name="$1"
    case "$name" in
        slack)
            niri msg --json windows | jq -r '.[] | select(.app_id == "slack") | .id' | head -n 1
            ;;
        telegram)
            niri msg --json windows | jq -r '
                .[]
                | select((.app_id // "" | test("telegram"; "i")) or (.title // "" | test("telegram"; "i")))
                | .id
            ' | head -n 1
            ;;
        discord)
            niri msg --json windows | jq -r '.[] | select(.app_id == "discord") | .id' | head -n 1
            ;;
    esac
}

launch_app() {
    local name="$1"
    case "$name" in
        slack)
            command -v slack >/dev/null 2>&1 && setsid -f slack >/dev/null 2>&1
            ;;
        telegram)
            if command -v Telegram >/dev/null 2>&1; then
                setsid -f Telegram >/dev/null 2>&1
            elif command -v telegram-desktop >/dev/null 2>&1; then
                setsid -f telegram-desktop >/dev/null 2>&1
            fi
            ;;
        discord)
            command -v discord >/dev/null 2>&1 && setsid -f discord >/dev/null 2>&1
            ;;
    esac
}

wait_for_window() {
    local name="$1" id
    for _ in {1..80}; do
        id="$(window_id_for "$name")"
        if [[ -n "$id" ]]; then
            printf '%s\n' "$id"
            return 0
        fi
        sleep 0.1
    done
    return 1
}

for app in slack telegram discord; do
    if [[ -z "$(window_id_for "$app")" ]]; then
        launch_app "$app"
    fi
done

ids=()
for app in slack telegram discord; do
    id="$(wait_for_window "$app" || true)"
    if [[ -n "$id" ]]; then
        ids+=("$id")
        niri msg action move-window-to-workspace --window-id "$id" --focus false "$COMMS_WS" >/dev/null || true
        niri msg action move-window-to-monitor --id "$id" "$VERTICAL_OUTPUT" >/dev/null || true
    fi
done

niri msg action focus-monitor "$VERTICAL_OUTPUT" >/dev/null
niri msg action focus-workspace "$COMMS_WS" >/dev/null

if ((${#ids[@]} > 0)); then
    column_of_window() {
        local id="$1"
        niri msg --json windows | jq -r --argjson id "$id" '.[] | select(.id == $id) | .layout.pos_in_scrolling_layout[0] // empty'
    }

    column_window_count() {
        local col="$1"
        niri msg --json windows | jq -r --argjson ws "$(niri msg --json workspaces | jq '.[] | select(.name == "comms") | .id')" --argjson col "$col" '
            [.[] | select(.workspace_id == $ws and .layout.pos_in_scrolling_layout[0] == $col)] | length
        '
    }

    expel_until_single() {
        local id="$1" col count
        for _ in {1..8}; do
            col="$(column_of_window "$id")"
            [[ -n "$col" ]] || return 0
            count="$(column_window_count "$col")"
            ((count <= 1)) && return 0
            niri msg action focus-window --id "$id" >/dev/null || return 0
            niri msg action expel-window-from-column >/dev/null 2>&1 || return 0
            sleep 0.05
        done
    }

    # Reset any previous comms stacking before building the desired column.
    for id in "${ids[@]}"; do
        expel_until_single "$id"
    done

    # Put separate columns in the desired left-to-right order:
    # Slack, Telegram, Discord. Then consume rightward into Slack.
    for i in "${!ids[@]}"; do
        niri msg action focus-window --id "${ids[$i]}" >/dev/null || true
        niri msg action move-column-to-index "$((i + 1))" >/dev/null || true
        sleep 0.05
    done

    niri msg action focus-window --id "${ids[0]}" >/dev/null || true
    niri msg action set-column-width "100%" >/dev/null || true

    for _ in "${ids[@]:1}"; do
        niri msg action focus-window --id "${ids[0]}" >/dev/null || true
        niri msg action consume-window-into-column >/dev/null 2>&1 || true
        sleep 0.05
    done

    height=$((100 / ${#ids[@]}))
    for id in "${ids[@]}"; do
        niri msg action set-window-height --id "$id" "${height}%" >/dev/null || true
    done

    niri msg action focus-window --id "${ids[0]}" >/dev/null || true
fi
